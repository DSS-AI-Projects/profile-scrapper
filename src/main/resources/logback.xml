<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender — shows INFO+ for the agent, WARN+ for everything else -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss} [%-5level] %logger{20} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender — full debug log -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>profile-scraper.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] %logger{36} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Agent classes: INFO to console + file -->
    <logger name="com.profilescraper" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Anthropic SDK: WARN only (it's chatty at INFO) -->
    <logger name="com.anthropic" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Suppress known harmless shutdown-time thread-leak warnings from Tomcat -->
    <logger name="org.apache.catalina.loader.WebappClassLoaderBase" level="ERROR" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Root: WARN -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
